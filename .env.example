# Copy to .env (never commit .env) or set these in your PowerShell session, e.g.
#   $env:REMOIR_LLM_PROVIDER = "ollama"

# Optional: require an X-API-Key header on all endpoints except /health
REMOIR_API_KEY=

# LLM provider: extractive (default, offline), ollama, or openai (OpenAI-compatible API)
REMOIR_LLM_PROVIDER=extractive
REMOIR_LLM_MODEL=llama3.2:3b
REMOIR_OLLAMA_URL=http://localhost:11434
REMOIR_OPENAI_BASE_URL=https://api.openai.com/v1
# Key for the OpenAI-compatible provider (read from the environment only)
REMOIR_LLM_API_KEY=

# Embeddings
REMOIR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Storage and limits
REMOIR_DATA_DIR=data
REMOIR_MAX_UPLOAD_MB=50
REMOIR_OCR_ENABLED=false

# Frontend -> backend URL
REMOIR_API_URL=http://127.0.0.1:8000
